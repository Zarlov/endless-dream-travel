#!/usr/bin/env bash
set -euo pipefail
umask 077

[[ $EUID -eq 0 ]] || { echo 'Run with sudo.' >&2; exit 1; }
source_dir="$(cd "$(dirname "$0")" && pwd)"

apt-get update
apt-get install -y age

install -d -m 0755 /etc/systemd/system/postgres-backup.timer.d
install -d -m 0755 /etc/systemd/system/espocrm-backup.timer.d
install -d -m 0755 /etc/systemd/system/postgres-backup.service.d
install -d -m 0755 /etc/systemd/system/espocrm-backup.service.d
install -d -m 0700 /opt/backups/espocrm-encrypted-export
install -d -m 0700 /mnt/osiris-proxmox-backups/CRM/encrypted-archives

install -m 0750 "$source_dir/crm-backup-alert" /usr/local/sbin/crm-backup-alert
install -m 0750 "$source_dir/crm-backup-postprocess" /usr/local/sbin/crm-backup-postprocess
if [[ ! -e /usr/local/sbin/backup-postgres.pre-encrypted-only ]]; then
  cp -a /usr/local/sbin/backup-postgres /usr/local/sbin/backup-postgres.pre-encrypted-only
fi
if [[ ! -e /usr/local/sbin/backup-espocrm.pre-encrypted-only ]]; then
  cp -a /usr/local/sbin/backup-espocrm /usr/local/sbin/backup-espocrm.pre-encrypted-only
fi
install -m 0750 "$source_dir/backup-postgres-local" /usr/local/sbin/backup-postgres
install -m 0750 "$source_dir/backup-espocrm-local" /usr/local/sbin/backup-espocrm
install -m 0750 "$source_dir/purge-unencrypted-osiris" /usr/local/sbin/purge-unencrypted-osiris
install -m 0600 "$source_dir/crm-backup-alerts.secret" /etc/default/crm-backup-alerts
install -m 0644 "$source_dir/crm-backup-alert@.service" /etc/systemd/system/crm-backup-alert@.service
install -m 0644 "$source_dir/postgres-backup.timer.conf" /etc/systemd/system/postgres-backup.timer.d/schedule.conf
install -m 0644 "$source_dir/espocrm-backup.timer.conf" /etc/systemd/system/espocrm-backup.timer.d/schedule.conf
install -m 0644 "$source_dir/postgres-backup.service.conf" /etc/systemd/system/postgres-backup.service.d/hardening.conf
install -m 0644 "$source_dir/espocrm-backup.service.conf" /etc/systemd/system/espocrm-backup.service.d/hardening.conf

audit_file=/opt/backups/espocrm-retention-setting-before-standardization.txt
{
  echo "Existing retention audit captured $(date -Is)"
  grep -Ein 'retention|mtime|mmin|delete|keep|prune' /usr/local/sbin/backup-postgres /usr/local/sbin/backup-espocrm || true
} >"$audit_file"
chmod 0600 "$audit_file"

if [[ ! -s /etc/default/crm-encrypted-export ]]; then
  age-keygen -o /home/ddriver/espocrm-offsite-recovery-key.txt
  chown ddriver:ddriver /home/ddriver/espocrm-offsite-recovery-key.txt
  chmod 0600 /home/ddriver/espocrm-offsite-recovery-key.txt
  recipient="$(age-keygen -y /home/ddriver/espocrm-offsite-recovery-key.txt)"
  printf 'AGE_RECIPIENT=%q\n' "$recipient" >/etc/default/crm-encrypted-export
  chmod 0600 /etc/default/crm-encrypted-export
fi

systemctl daemon-reload
systemctl restart postgres-backup.timer espocrm-backup.timer
systemctl enable postgres-backup.timer espocrm-backup.timer
systemctl list-timers postgres-backup.timer espocrm-backup.timer --all --no-pager

echo
echo 'Installation complete.'
echo 'Readable backups remain on the CRM VM for 14 days.'
echo 'Encrypted archives will appear in /mnt/osiris-proxmox-backups/CRM/encrypted-archives.'
echo 'Run purge-unencrypted-osiris only after a new encrypted archive has been verified.'
