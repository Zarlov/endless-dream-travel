{
  "fields": {
    "edtVendorExternalId": {
      "type": "varchar",
      "maxLength": 60,
      "index": true,
      "relateOnImport": true
    },
    "edtVendor": {
      "type": "bool",
      "default": false
    },
    "edtVendorType": {
      "type": "enum",
      "options": [
        "Cruise Line",
        "Theme Park",
        "Resort / Hotel",
        "Tour / Excursion",
        "Insurance",
        "Transportation",
        "Airline",
        "Wholesaler",
        "Other"
      ]
    },
    "edtSupplierCode": {
      "type": "varchar",
      "maxLength": 50
    },
    "edtVendorEmailName": {
      "type": "varchar",
      "maxLength": 180
    },
    "edtVendorStatus": {
      "type": "enum",
      "options": [
        "Active",
        "Inactive"
      ],
      "default": "Active"
    },
    "edtMarketingCategory": {
      "type": "enum",
      "options": [
        "Cruise",
        "Disney",
        "Universal",
        "Resort",
        "Tour / Excursion",
        "Insurance",
        "Transportation",
        "Air",
        "Other"
      ]
    },
    "edtClients": {
      "type": "linkMultiple"
    }
  },
  "links": {
    "edtBookings": {
      "type": "hasMany",
      "entity": "EdtBooking",
      "foreign": "supplier"
    },
    "edtCommissions": {
      "type": "hasMany",
      "entity": "EdtCommission",
      "foreign": "supplier"
    },
    "edtQuotes": {
      "type": "hasMany",
      "entity": "EdtQuote",
      "foreign": "supplier"
    },
    "edtLoyaltyMemberships": {
      "type": "hasMany",
      "entity": "EdtLoyaltyMembership",
      "foreign": "supplier"
    },
    "edtClients": {
      "type": "hasMany",
      "entity": "Contact",
      "relationName": "edtVendorClient",
      "foreign": "edtVendors"
    }
  },
  "indexes": {
    "edtVendorExternalIdUnique": {
      "columns": [
        "edtVendorExternalId"
      ],
      "unique": true
    }
  }
}
