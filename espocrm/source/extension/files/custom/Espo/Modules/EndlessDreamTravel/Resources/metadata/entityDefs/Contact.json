      "type": "enum",
      "options": [
        "Unknown",
        "Opted In",
        "Opted Out"
      ],
      "default": "Unknown"
    },
    "travelerStatus": {
      "type": "enum",
      "options": [
        "Prospect",
        "Customer",
        "Inactive"
      ],
      "default": "Prospect"
    },
    "nameParseConfidence": {
      "type": "enum",
      "options": [
        "Corrected",
        "High",
        "Medium",
        "Low"
      ]
    },
    "sourceNameExample": {
      "type": "varchar",
      "maxLength": 255
    },
    "manualReviewNote": {
      "type": "text"
    },
    "totalBookings": {
      "type": "int",
      "default": 0
    },
    "lifetimeSales": {
      "type": "currency"
    },
    "lifetimeCommission": {
      "type": "currency"
    },
    "lastTravelYear": {
      "type": "int"
    },
    "vendorsBooked": {
      "type": "text"
    },
    "marketingSegments": {
      "type": "text"
    }
