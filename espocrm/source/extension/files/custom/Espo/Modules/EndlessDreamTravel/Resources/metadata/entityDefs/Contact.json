  "links": {
    "household": {
      "type": "belongsTo",
      "entity": "EdtHousehold",
      "foreign": "contacts"
    },
    "primaryHouseholds": {
      "type": "hasMany",
      "entity": "EdtHousehold",
      "foreign": "primaryTraveler"
    },
    "primaryTrips": {
      "type": "hasMany",
      "entity": "EdtTrip",
      "foreign": "primaryTraveler"
    },
    "primaryBookings": {
      "type": "hasMany",
      "entity": "EdtBooking",
      "foreign": "primaryTraveler"
    },
    "primaryQuotes": {
      "type": "hasMany",
      "entity": "EdtQuote",
      "foreign": "primaryContact"
    },
    "edtTripTravelers": {
      "type": "hasMany",
      "entity": "EdtTripTraveler",
      "foreign": "contact"
    },
    "edtBookingTravelers": {
      "type": "hasMany",
      "entity": "EdtBookingTraveler",
      "foreign": "contact"
    },
    "edtLoyaltyMemberships": {
      "type": "hasMany",
      "entity": "EdtLoyaltyMembership",
      "foreign": "contact"
    },
    "edtSegmentMemberships": {
      "type": "hasMany",
      "entity": "EdtSegmentMembership",
      "foreign": "contact"
    },
    "edtQuotes": {
      "type": "hasMany",
      "entity": "EdtQuote",
      "relationName": "edtQuoteContact",
      "foreign": "clients"
    },
    "edtVendors": {
      "type": "hasMany",
      "entity": "Account",
      "relationName": "edtVendorClient",
      "foreign": "edtClients"
    },
    "edtPaymentReminderBookings": {
      "type": "hasMany",
      "entity": "EdtBooking",
      "relationName": "edtBookingReminderRecipient",
      "foreign": "clientReminderRecipients"
    }
  },
  "indexes": {
    "edtExternalIdUnique": {
      "columns": [
        "edtExternalId"
      ],
      "unique": true
    }
  }
}
