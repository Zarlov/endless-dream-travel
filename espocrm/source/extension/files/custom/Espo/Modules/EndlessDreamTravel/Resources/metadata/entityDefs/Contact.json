{
  "fields": {
    "edtExternalId": {
      "type": "varchar",
      "maxLength": 50,
      "index": true,
      "relateOnImport": true
    },
    "household": {
      "type": "link"
    },
    "isPrimaryHouseholdContact": {
      "type": "bool",
      "default": false
    },
    "edtAutoCreateHousehold": {
      "type": "bool",
      "default": false
    },
    "edtUseHouseholdAddress": {
      "type": "bool",
      "default": false
    },
    "edtAddressLine1": {
      "type": "varchar",
      "maxLength": 255,
      "isPersonalData": true
    },
    "edtAddressLine2": {
      "type": "varchar",
      "maxLength": 255,
      "isPersonalData": true
    },
    "edtCity": {
      "type": "varchar",
      "maxLength": 100,
      "isPersonalData": true
    },
    "edtState": {
      "type": "varchar",
      "maxLength": 100,
      "isPersonalData": true
    },
    "edtPostalCode": {
      "type": "varchar",
      "maxLength": 20,
      "isPersonalData": true
