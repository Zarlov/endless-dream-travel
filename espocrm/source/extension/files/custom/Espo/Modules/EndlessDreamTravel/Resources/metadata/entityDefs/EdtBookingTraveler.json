{
  "fields": {
    "name": {
      "type": "varchar",
      "maxLength": 180
    },
    "externalId": {
      "type": "varchar",
      "maxLength": 60,
      "index": true,
      "readOnlyAfterCreate": true
    },
    "booking": {
      "type": "link",
      "required": true
    },
    "contact": {
      "type": "link",
      "required": true
    },
    "travelerRole": {
      "type": "enum",
      "options": [
        "Primary",
        "Traveler",
        "Guest",
        "Group Lead"
      ],
      "default": "Traveler"
    },
    "nameParseConfidence": {
      "type": "enum",
      "options": [
        "Corrected",
        "High",
        "Medium",
        "Low"
      ]
    },
    "sourceNameLabel": {
      "type": "varchar",
      "maxLength": 255
    },
    "manualReviewRequired": {
      "type": "bool",
      "default": false
    },
    "createdAt": {
      "type": "datetime",
      "readOnly": true,
      "customizationDisabled": true
    },
    "modifiedAt": {
      "type": "datetime",
      "readOnly": true,
      "customizationDisabled": true
    },
    "createdBy": {
      "type": "link",
      "readOnly": true,
      "customizationDisabled": true,
      "view": "views/fields/user"
    },
    "modifiedBy": {
      "type": "link",
      "readOnly": true,
      "customizationDisabled": true,
      "view": "views/fields/user"
    }
  },
  "links": {
    "booking": {
      "type": "belongsTo",
      "entity": "EdtBooking",
      "foreign": "bookingTravelers"
    },
    "contact": {
      "type": "belongsTo",
      "entity": "Contact",
      "foreign": "edtBookingTravelers"
    },
    "createdBy": {
      "type": "belongsTo",
      "entity": "User"
    },
    "modifiedBy": {
      "type": "belongsTo",
      "entity": "User"
    }
  },
  "indexes": {
    "externalIdUnique": {
      "columns": [
        "externalId"
      ],
      "unique": true
    },
    "bookingContactUnique": {
      "columns": [
        "bookingId",
        "contactId"
      ],
      "unique": true
    }
  },
  "collection": {
    "textFilterFields": [
      "name",
      "externalId"
    ],
    "orderBy": "createdAt",
    "order": "desc"
  },
  "transactionalSave": true
}
