{
  "fields": {
    "name": {
      "type": "varchar",
      "maxLength": 180,
      "readOnly": true
    },
    "externalId": {
      "type": "varchar",
      "maxLength": 60,
      "index": true,
      "readOnlyAfterCreate": true
    },
    "booking": {
      "type": "link",
      "required": true,
      "view": "endless-dream-travel:views/fields/commission-booking"
    },
    "supplier": {
      "type": "link"
    },
    "type": {
      "type": "enum",
      "options": [
        "Base Commission",
        "Bonus",
        "Adjustment",
        "Clawback"
      ],
      "default": "Base Commission"
    },
    "expectedAmount": {
      "type": "currency"
    },
    "receivedAmount": {
      "type": "currency"
    },
    "status": {
      "type": "enum",
      "options": [
        "Expected",
        "Received",
        "Disputed",
        "Written Off",
        "Removed / Do Not Import"
      ],
      "default": "Expected"
    },
    "receivedDate": {
      "type": "date"
    },
    "autoGenerated": {
      "type": "bool",
      "default": false,
      "readOnly": true
    },
    "reconciliationNote": {
      "type": "text"
    },
    "assignedUser": {
      "type": "link"
    },
    "teams": {
      "type": "linkMultiple"
    },
    "createdAt": {
      "type": "datetime",
      "readOnly": true,
      "customizationDisabled": true
    },
    "modifiedAt": {
      "type": "datetime",
      "readOnly": true,
      "customizationDisabled": true
    },
    "createdBy": {
      "type": "link",
      "readOnly": true,
      "customizationDisabled": true,
      "view": "views/fields/user"
    },
    "modifiedBy": {
      "type": "link",
      "readOnly": true,
      "customizationDisabled": true,
      "view": "views/fields/user"
    }
  },
  "links": {
    "booking": {
      "type": "belongsTo",
      "entity": "EdtBooking",
      "foreign": "commissions"
    },
    "supplier": {
      "type": "belongsTo",
      "entity": "Account",
      "foreign": "edtCommissions"
    },
    "assignedUser": {
      "type": "belongsTo",
      "entity": "User",
      "foreign": "edtCommissions"
    },
    "teams": {
      "type": "hasMany",
      "entity": "Team",
      "relationName": "entityTeam"
    },
    "createdBy": {
      "type": "belongsTo",
      "entity": "User"
    },
    "modifiedBy": {
      "type": "belongsTo",
      "entity": "User"
    }
  },
  "indexes": {
    "externalIdUnique": {
      "columns": [
        "externalId"
      ],
      "unique": true
    },
    "receivedDate": {
      "columns": [
        "receivedDate"
      ]
    }
  },
  "collection": {
    "textFilterFields": [
      "name",
      "externalId"
    ],
    "orderBy": "createdAt",
    "order": "desc"
  },
  "transactionalSave": true
}
